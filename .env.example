# required
ANTHROPIC_API_KEY=

# optional: open real pull requests (fork of the analysed repo you can push to)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# optional: FalkorDB location (docker compose default)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# optional: model and tool transport
BLAST_MODEL=claude-opus-5-5
BLAST_TOOLS=mcp            # mcp (default) or direct
BLAST_EFFORT=              # low | medium | high, blank = model default
